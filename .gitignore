desktop.ini

# -----------------------------------------------------------------------------
# 3. 第三方 jar（Create / Sable / Aeronautics / Flywheel / Registrate / JEI /
#    CC:Tweaked 等，版权归各自作者，绝对不能提交）
#    只放行 Gradle Wrapper 自带的 gradle-wrapper.jar；
#    libs/ 目录用 README 说明如何自行获取，见 clockwork_unoffical/libs/README.md
# -----------------------------------------------------------------------------
*.jar
/clockwork_unoffical/libs/*.jar
!/clockwork_unoffical/gradle/wrapper/gradle-wrapper.jar

# tools/simjar/ 下是从整合包抽出的第三方 jar（Simulated），同样不入库
/tools/simjar/

# -----------------------------------------------------------------------------
# 4. 本机验证产物：把构建好的 jar 解包到工程根目录做内容核对时留下的临时树
#    （assets / data / META-INF / org / resourcepacks / icon / mixins.json）
# -----------------------------------------------------------------------------
/clockwork_unoffical/assets/
/clockwork_unoffical/data/
/clockwork_unoffical/META-INF/
/clockwork_unoffical/org/
/clockwork_unoffical/resourcepacks/
/clockwork_unoffical/icon.png
